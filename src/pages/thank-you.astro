---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Enquiry Confirmed | Paranjape Forest Trails Bhugaon Pune"
  description="Thank you for your interest in Paranjape Forest Trails. Our sales concierge will connect with you shortly with official floor plans and pricing."
>
  <section
    style="min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 4rem 1.5rem; background: radial-gradient(circle at 50% 30%, rgba(212,175,55,0.08) 0%, #0e0c14 70%);"
  >
    <div
      class="glass-card"
      style="max-width: 620px; width: 100%; text-align: center; padding: 3rem 2.2rem; border: 1.5px solid rgba(212, 175, 55, 0.45); border-radius: 24px; background: rgba(14, 14, 18, 0.92); backdrop-filter: blur(28px); box-shadow: 0 25px 70px rgba(0,0,0,0.95), 0 0 40px rgba(212,175,55,0.25);"
    >
      {/* Success Icon */}
      <div
        style="width: 76px; height: 76px; margin: 0 auto 1.5rem; background: rgba(37, 211, 102, 0.12); border: 2px solid #25D366; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.2rem; box-shadow: 0 0 30px rgba(37,211,102,0.35);"
      >
        ✓
      </div>

      {/* Badge */}
      <span
        style="display: inline-block; background: rgba(212, 175, 55, 0.12); border: 1px solid rgba(212, 175, 55, 0.4); color: #D4AF37; font-weight: 800; font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; padding: 0.3rem 1rem; border-radius: 50px; margin-bottom: 1rem;"
      >
        ✦ ADVISORY REQUEST RECEIVED
      </span>

      {/* Title */}
      <h1
        style="font-family: 'Playfair Display', serif; font-size: clamp(1.8rem, 3.5vw, 2.4rem); color: #ffffff; margin: 0 0 0.8rem; line-height: 1.2;"
      >
        Thank You! Your Request is <span style="color: #D4AF37; background: linear-gradient(135deg, #FFFFFF 20%, #D4AF37 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Confirmed</span>
      </h1>

      {/* Description */}
      <p
        style="color: rgba(255, 255, 255, 0.82); font-size: 0.95rem; line-height: 1.65; margin: 0 auto 2rem; max-width: 500px;"
      >
        Thank you for contacting <strong style="color: #fff;">Paranjape Forest Trails Bhugaon</strong>. Our dedicated sales advisory team has received your details and will connect with you shortly with official floor plans, master layouts, and developer pricing.
      </p>

      {/* Instant Action Grid */}
      <div style="display: flex; flex-direction: column; gap: 0.9rem; max-width: 420px; margin: 0 auto 1.8rem;">
        <a
          href="https://wa.me/917744009295?text=Hi%2C%20I%20just%20submitted%20an%20enquiry%20on%20the%20Paranjape%20Forest%20Trails%20website.%20Please%20share%20the%20e-brochure%20and%20price%20sheet."
          target="_blank"
          rel="noopener"
          style="background: #25D366; color: #ffffff; padding: 0.9rem 1.5rem; border-radius: 12px; font-weight: 800; font-size: 0.85rem; letter-spacing: 0.05em; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 6px 20px rgba(37,211,102,0.4);"
        >
          <span>💬</span>
          <span>CONNECT ON WHATSAPP NOW</span>
        </a>

        <a
          href="/"
          style="background: linear-gradient(135deg, #6B0D0D, #8B1A1A); color: #ffffff; border: 1.5px solid #D4AF37; padding: 0.85rem 1.5rem; border-radius: 12px; font-weight: 800; font-size: 0.82rem; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 6px; box-shadow: 0 6px 20px rgba(107,13,13,0.45);"
        >
          <span>🏠</span>
          <span>RETURN TO HOMEPAGE</span>
        </a>
      </div>

      {/* Trust Footer */}
      <div style="border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1.2rem; display: flex; justify-content: center; align-items: center; gap: 15px; font-size: 0.72rem; color: rgba(255,255,255,0.5);">
        <span>🔒 100% Confidential</span>
        <span>•</span>
        <span>🏛️ Direct PSCL Channel</span>
        <span>•</span>
        <span>📜 MahaRERA Verified</span>
      </div>
    </div>
  </section>
</BaseLayout>
