---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { EnquiryModal } from '../components/react/EnquiryModal';
import { QuickContactBar } from '../components/react/QuickContactBar';
import { ComparisonDrawer } from '../components/react/ComparisonDrawer';
import '../styles/tokens.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
}

const {
  title = "NA Plots & Villas | Paranjape Forest Trails Bhugaon | Pune West",
  description = "Explore Paranjape Forest Trails Bhugaon, Pune's premier 190-acre township. Featuring RERA approved NA plots & luxury villas near Kothrud & Bavdhan.",
  canonical = Astro.url.href,
  image = "/images/hero-township.webp"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  {/* Google Search Console & Directives */}
  <meta name="google-site-verification" content="fA009Y6RAvi_yacg8Lw7JJu5uvAGR5po2RIUH8VcuvE" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <meta name="bingbot" content="index, follow, max-image-preview:large" />
  
  {/* Geo-Targeting & Micro-Market Semantic Authority */}
  <meta name="geo.region" content="IN-MH" />
  <meta name="geo.placename" content="Bhugaon, Pune West, Maharashtra, India" />
  <meta name="geo.position" content="18.5050;73.7406" />
  <meta name="ICBM" content="18.5050, 73.7406" />
  <meta name="city" content="Pune" />
  <meta name="country" content="India" />

  {/* Open Graph */}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={image} />
  <meta property="og:site_name" content="Paranjape Forest Trails Township Bhugaon" />

  {/* Twitter Cards */}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  {/* Preconnect & Typography */}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" />

  {/* Global Favicons & Mobile PWA */}
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#4A0808" />
  <meta name="msapplication-TileColor" content="#4A0808" />

  {/* Google Analytics GA4 */}
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-PARANJAPE"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-PARANJAPE', { 'send_page_view': true });
  </script>

  {/* Cloudflare Edge Speculation Rules (Instant 0ms Page Pre-rendering) */}
  <script type="speculationrules" is:inline>
  {
    "prerender": [
      {
        "source": "list",
        "urls": [
          "/paranjape-forest-trails-township-bhugaon-misty-greens/",
          "/paranjape-forest-trails-township-bhugaon-rivolo-residences/",
          "/paranjape-forest-trails-township-bhugaon-the-canopy/",
          "/paranjape-forest-trails-township-bhugaon-athashri-senior-living-bhugaon/",
          "/paranjape-forest-trails-township-bhugaon-the-cove/",
          "/paranjape-forest-trails-township-bhugaon-highgardens/",
          "/paranjape-forest-trails-township-bhugaon-price/",
          "/paranjape-forest-trails-township-bhugaon-location-proximity/"
        ],
        "eagerness": "moderate"
      }
    ]
  }
  </script>

  {/* Cloudflare Web Analytics (RUM & Core Web Vitals Monitoring) */}
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "paranjape-forest-trails-edge"}'></script>

  {/* Google Master Structured Data Knowledge Graph & Sitelinks Search */}
  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "RealEstateProject",
      "name": "Paranjape Forest Trails",
      "description": "190-Acre Integrated Forest-Themed Township in Bhugaon, West Pune. Features luxury villas, premium apartments, and NA bungalow plots.",
      "url": "https://www.paranjapetownship.com/",
      "brand": { "@type": "Brand", "name": "Paranjape Schemes" },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Paud Road, Bhugaon",
        "addressLocality": "Bhugaon",
        "addressRegion": "Pune",
        "postalCode": "412115",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "18.5050",
        "longitude": "73.7406"
      },
      "amenityFeature": [
        "The Cliff Club",
        "Equestrian Academy",
        "Forest Trails",
        "Olympic Size Pool",
        "Tennis Courts",
        "SSRVM School"
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Paranjape Forest Trails",
      "alternateName": ["Paranjape Schemes Forest Trails", "Forest Trails Bhugaon"],
      "url": "https://www.paranjapetownship.com/",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://www.paranjapetownship.com/?s={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Paranjape Schemes (Construction) Ltd",
      "url": "https://pscl.in",
      "logo": "https://www.paranjapetownship.com/assets/branding/paranjape-corporate-logo.jpg",
      "foundingDate": "1987",
      "sameAs": [
        "https://www.facebook.com/ParanjapeSchemes",
        "https://twitter.com/pscl",
        "https://www.linkedin.com/company/paranjape-schemes-construction-ltd-/"
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What are the configuration options in Paranjape Forest Trails Bhugaon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Paranjape Forest Trails offers 1,930 to 3,500+ sq.ft NA Bungalow Plots in Misty Greens, 4 & 5 BHK Luxury Forest Villas in The Rivolo, 4 BHK Duet Villas in The Cove, 2 & 3 BHK Nature Apartments in The Canopy & Highgardens, and Senior Assisted Living in Athashri & Swaniketan."
          }
        },
        {
          "@type": "Question",
          "name": "Are the plots in Misty Greens PMRDA approved with clear 7/12 title?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, Misty Greens plots are 100% PMRDA sanctioned and MahaRERA approved (P52100053834 / P52100049327) with individual 7/12 extract demarcation and clear legal title."
          }
        },
        {
          "@type": "Question",
          "name": "What is the starting price of villas and plots in Forest Trails Bhugaon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "NA Bungalow plots in Misty Greens start from ₹1.23 Cr*, apartments in Everglades and The Canopy start from ₹48.50 Lakhs* & ₹89 Lakhs*, and luxury forest villas in The Rivolo start from ₹3.89 Cr*."
          }
        },
        {
          "@type": "Question",
          "name": "What lifestyle amenities are available inside Forest Trails township?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The 190-acre township features The Cliff Club (40,000+ sq.ft sports & lifestyle hub with Olympic size pool), a professional Equestrian Horse Riding Academy, and Sri Sri Ravishankar Vidya Mandir (SSRVM) ICSE school."
          }
        }
      ]
    }
  ]
  </script>

  <style is:global>
    body {
      margin: 0;
      padding: 0;
      background: #09090b;
      color: #ffffff;
      font-family: 'Plus Jakarta Sans', sans-serif;
      overflow-x: hidden;
    }
    @media (max-width: 768px) {
      .mobile-quick-bar {
        display: flex !important;
      }
      body {
        padding-bottom: 60px;
      }
    }
  </style>
</head>
<body>
  <Header />

  <main>
    <slot />
  </main>

  <Footer />

  {/* React Islands */}
  <EnquiryModal client:idle />
  <QuickContactBar client:idle />
  <ComparisonDrawer client:idle />

  {/* Global Client Script for Filter Engine */}
  <script is:inline>
    window.filterProjects = function(category) {
      const cards = document.querySelectorAll('.cluster-card');
      cards.forEach(card => {
        const cat = card.getAttribute('data-category');
        if (category === 'all' || cat === category) {
          card.style.display = 'flex';
          card.style.opacity = '0';
          setTimeout(() => {
            card.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
            card.style.opacity = '1';
          }, 40);
        } else {
          card.style.display = 'none';
        }
      });
    };
  </script>
</body>
</html>
